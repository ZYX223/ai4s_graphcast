    "524288",
    "--loss-grid-chunk-size",
    "65536",
    "--grid2mesh-stage-device",
    "primary",
    "--grid2mesh-node-stage-device",
    "stage",
    "--grid2mesh-stage-checkpoint",
    "enabled",
    "--mesh2grid-stage-device",
    "output",
    "--mesh2grid-node-stage-device",
    "primary",
    "--mesh2grid-decoder-stage-device",
    "primary",
    "--mesh2grid-stage-checkpoint",
    "disabled",
    "--single-step-rollout-checkpoint",
    "enabled",
    "--rollout-checkpoint-implementation",
    "reentrant",
    "--split-cache-max-gib",
    "16.0",
    "--data-prefetch-depth",
    "1",
    "--formal",
    "--activation-checkpoint",
    "--init-checkpoint",
    "${INITIAL}",
    "--allow-pretrained-era5-init",
    "--profile-hotspots",
    "--profile-wait",
    "1",
    "--profile-warmup",
    "1",
    "--profile-active",
    "1",
    "--profile-repeat",
    "1",
    "--profile-top-k",
    "1000"
  ],
  "output_dir": "${OUTPUT}",
  "environment": {
    "PYTHONUNBUFFERED": "1",
    "PYTHONNOUSERSITE": "1",
    "MACA_CLANG_PATH": "/opt/maca/mxgpu_llvm/bin",
    "PET_LOCAL_ADDR": "127.0.0.1",
    "OPENBLAS_NUM_THREADS": "8",
    "MACA_PATH": "/opt/maca",
    "CUDA_VISIBLE_DEVICES": "${MASK}",
    "PYTHONPATH": "${GEMS}/src:${MODEL}/src:${DEPENDENCIES}",
    "LIBRARY_PATH": "/opt/mxdriver/lib:",
    "PYTHONDONTWRITEBYTECODE": "1",
    "LD_LIBRARY_PATH": "/opt/maca/lib:/opt/maca/mxshmem/lib:/opt/maca/ompi/lib:/opt/maca/ucx/lib:/opt/mxdriver/lib:",
    "OMP_NUM_THREADS": "8",
    "PATH": "/opt/conda/bin:/opt/conda/condabin:/opt/maca/bin:/opt/maca/mxgpu_llvm/bin:/opt/maca/ompi/bin:/opt/maca/ucx/bin:/opt/mxdriver/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "DEBIAN_FRONTEND": "noninteractive",
    "LC_CTYPE": "C.UTF-8",
    "NUMPY_MADVISE_HUGEPAGE": "0",
    "GRAPHCAST_PLATFORM": "metax",
    "GRAPHCAST_PLATFORM_LABEL": "MetaX C550",
    "GRAPHCAST_ACCELERATOR_TYPE": "cuda",
    "GRAPHCAST_BACKEND": "metax",
    "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
    "GRAPHCAST_FLAGOS_MODE": "flaggems",
    "FLAGOS_REPLACE": "1",
    "GRAPHCAST_FLAGGEMS_CONFIG": "${MODEL}/configs/flaggems/graphcast_training_full.yaml",
    "GRAPHCAST_FLAGGEMS_OPS": "addmm,cat,native_layer_norm,index_add_,index_add,silu,index,add,copy_,fill_scalar_,fill_tensor_,mul,sub,sum,pow_tensor_scalar,pow_tensor_tensor,pow_scalar,mean,true_divide,div_mode,abs,ne,eq,all,clamp_min,index_select,mm,add_,layer_norm_backward,_index_put_impl_,silu_backward,gather,remainder,true_divide_,div_mode_,arange",
    "GRAPHCAST_FLAGGEMS_VARIANT": "installed",
    "GRAPHCAST_STRICT_FLAGOS": "1",
    "FLAGGEMS_CACHE_DIR": "${OUTPUT}/cache/flaggems",
    "TRITON_CACHE_DIR": "${OUTPUT}/cache/triton",
    "XDG_CACHE_HOME": "${OUTPUT}/cache/xdg",
    "GRAPHCAST_TRAINING_FLAGGEMS_RUNTIME": "corrections",
    "GRAPHCAST_FLAGGEMS_SOURCE_ROOT": "${GEMS}",
    "GEMS_VENDOR": "metax"
  },
  "input_file_sha256": {
