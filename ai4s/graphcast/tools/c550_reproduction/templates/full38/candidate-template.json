    "--training-start",
    "",
    "--training-end",
    "",
    "--edge-gather-group-size",
    "4",
    "--resident-training-inputs",
    "enabled",
    "--gradient-sync",
    "manual",
    "--mesh-split-step",
    "16",
    "--mesh-checkpoint-granularity",
    "step",
    "--mesh-edge-input-projection",
    "concatenated",
    "--edge-chunk-size",
    "131072",
    "--grid-node-chunk-size",
