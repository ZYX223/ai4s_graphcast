    "${TRAIN_DATA}/stats/mean_by_level.nc": "e6e724b94cd27707903cdc5cf5784d420bab306f722e631f4455e25c96da9931",
    "${TRAIN_DATA}/stats/diffs_stddev_by_level.nc": "e688fc51fe72e1dc897678ef5ce9889add64e28e13f3cec4758d8e47d429c1ce",
    "${TRAIN_DATA}/stats/stddev_by_level.nc": "29f941d8c34906b87a1745f93b2308d1e169ec9bbdc4c5491479c771fe92c3cb"
