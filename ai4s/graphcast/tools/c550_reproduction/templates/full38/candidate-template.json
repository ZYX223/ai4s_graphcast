    "--corpus-manifest",
    "${TRAIN_DATA}/corpora/era5_2017-01-01_07_train.json",
    "--dataset-kind",
    "era5",
    "--training-stage",
    "era5_pretrain",
    "--global-batch-size",
    "2",
    "--global-micro-batch-size",
    "1",
    "--data-parallel-replicas",
    "1",
    "--mp-devices-per-replica",
    "1",
    "--rollout-steps",
    "12",
    "--rollout-checkpoint-segments",
    "12",
    "--tensor-core",
    "enabled",
    "--precision",
    "fp32",
    "--init-mode",
    "checkpoint",
