    "6",
    "--training-updates",
    "10",
    "--updates",
    "22",
    "--run-dir",
    "${OUTPUT}/run",
    "--save-checkpoint",
    "${OUTPUT}/run/final_checkpoint.pt",
    "--checkpoint-every-steps",
