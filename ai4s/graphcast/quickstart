# ── helpers ─────────────────────────────────────────────────────────────────


def run(cmd: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, check=False, text=True, **kwargs)


def red(msg: str) -> str:
    return f"\033[31m{msg}\033[0m"


def green(msg: str) -> str:
    return f"\033[32m{msg}\033[0m"


def bold(msg: str) -> str:
    return f"\033[1m{msg}\033[0m"


def build_flagos_environment(
    *,
    platform: str,
    mode: str | None,
    ops: str | None,
    profile: str,
    config: str | None = None,
    source_root: str | None = None,
    variant: str = "installed",
) -> dict[str, str]:
    """Build one runtime environment for either inference or training."""

    backend = PLATFORM_CONFIG[platform].get("backend_suffix", platform)
    normalized_mode = (mode or "off").strip().lower()
    env = {
        "GRAPHCAST_BACKEND": backend,
        "GRAPHCAST_FLAGOS_MODE": normalized_mode,
    }
    if normalized_mode != "flaggems":
        return env
    env["GRAPHCAST_FLAGGEMS_VARIANT"] = variant
    env["GRAPHCAST_STRICT_FLAGOS"] = "1"
    if ops:
        env["GRAPHCAST_FLAGGEMS_OPS"] = ops
    else:
        env["GRAPHCAST_FLAGGEMS_CONFIG"] = config or FLAGGEMS_PROFILE_CONFIGS[profile]
    if source_root:
        env["GRAPHCAST_FLAGGEMS_SOURCE_ROOT"] = source_root
    return env


def _shell_environment(env: dict[str, str]) -> str:
    return " ".join(f"{name}={shlex.quote(value)}" for name, value in env.items())


# ── GPU detection ───────────────────────────────────────────────────────────


def detect_platform() -> str | None:
    """Try each platform's GPU query tool; return first that succeeds."""
    # PPU machines have a working nvidia-smi in PATH, so detect by /dev/alixpu first
    if os.path.exists("/dev/alixpu"):
        return "ppu"

    for name, cmd_list in GPU_CHECK_CMDS.items():
        for cmd in cmd_list:
            exe = cmd[0]
            if shutil.which(exe) or os.path.exists(exe):
                try:
                    result = run(cmd, capture_output=True, timeout=15)
                    if result.returncode == 0 and result.stdout.strip():
                        return name
                except Exception:
                    continue
    return None


def find_free_gpus(platform: str, count: int = 4, user_spec: str | None = None) -> list[int]:
    """Return list of free GPU IDs (memory < 5 GB)."""
    if user_spec:
        return [int(x.strip()) for x in user_spec.split(",")]

    cmds = GPU_CHECK_CMDS.get(platform, [])
    if not cmds:
        return list(range(count))

    # Try each command variant until one succeeds
    result = None
    for cmd in cmds:
        exe = cmd[0]
        if shutil.which(exe) or os.path.exists(exe):
            try:
                result = run(cmd, capture_output=True, timeout=15)
                if result.returncode == 0 and result.stdout.strip():
                    break
            except Exception:
                continue

    if result is None or result.returncode != 0:
        return list(range(count))

    free: list[int] = []

    if platform == "ascend":
        free = _find_free_ascend(result, count)
    elif platform == "hygon":
        free = _find_free_hygon(result, count)
    else:
        free = _find_free_nvidia(result, count)

    free.sort()
    return free[:count]


def _find_free_ascend(result: subprocess.CompletedProcess, count: int) -> list[int]:
    """Ascend: detect at NPU level, output at chip level.

    npu-smi output interleaves Name rows (1 slash) and Chip rows (2 slashes).
    Chips within an NPU share resources — NPU is usable only when ALL its
    chips have HBM < 5 GB AND no process runs on any chip.
    ASCEND_RT_VISIBLE_DEVICES expects chip physical IDs.  910C = 2 chips/NPU.
    """
    free: list[int] = []
    chip_data: list[dict] = []  # [{phy_id, npu_id, used_hbm}, ...]
    npu_chip_count: dict[int, int] = {}

    for line in result.stdout.strip().split("\n"):
        line = line.strip()
        if not line:
            continue
        parts = [p.strip() for p in line.split("|") if p.strip()]
        if len(parts) < 3 or parts[2].count("/") != 2:
            continue  # skip name rows, keep chip rows only
        tokens = parts[2].split("/")
        if len(tokens) < 3:
            continue
        try:
            used_hbm = int(tokens[-2].strip().split()[-1])
        except (ValueError, IndexError):
            continue
        chip_parts = parts[0].split()
        if len(chip_parts) < 2:
            continue
        try:
            phy_id = int(chip_parts[1])
        except ValueError:
            continue
        npu_id = phy_id // 2
        chip_data.append({"phy_id": phy_id, "npu_id": npu_id, "used_hbm": used_hbm})
        npu_chip_count[npu_id] = npu_chip_count.get(npu_id, 0) + 1

    # NPU free if all its chips have HBM < 5 GB
    npu_free: dict[int, bool] = {}
    for cd in chip_data:
        nid = cd["npu_id"]
        if nid not in npu_free:
            npu_free[nid] = True
        if cd["used_hbm"] >= 5000:
            npu_free[nid] = False

    # Also exclude NPUs that have running processes
    in_process_section = False
    for line in result.stdout.strip().split("\n"):
        if "Process id" in line:
            in_process_section = True
            continue
        if not in_process_section:
            continue
        line = line.strip()
        if not line or line.startswith("+"):
            continue
        if "No running processes" in line:
            continue
        # Process row: leading |, then "NPU_ID  Chip_ID" in second field
        row = [p.strip() for p in line.split("|")]
        if len(row) >= 2:
            ids = row[1].split()
            if ids:
                try:
                    npu_free[int(ids[0])] = False
                except (ValueError, KeyError):
                    pass

    free_npus = sorted(nid for nid, ok in npu_free.items() if ok)
    if not free_npus:
        return free

    chips_per_npu = npu_chip_count.get(free_npus[0], 2)
    needed_npus = (count + chips_per_npu - 1) // chips_per_npu  # ceil
    for cd in chip_data:
        if cd["npu_id"] in free_npus[:needed_npus]:
            free.append(cd["phy_id"])
    return free


def _find_free_hygon(result: subprocess.CompletedProcess, count: int) -> list[int]:
    """Hygon: parse rocm-smi --showmeminfo vram output."""
    free: list[int] = []
    import re as _re

    for line in result.stdout.strip().split("\n"):
        line = line.strip()
        if not line:
            continue
        # Format: "HCU[0]: vram Total Used Memory (MiB): 2"
        if "Total Used Memory" in line and "HCU[" in line:
            m_idx = _re.search(r"HCU\[(\d+)\]", line)
            m_mem = _re.search(r"Used Memory \(MiB\):\s*(\d+)", line)
            if m_idx and m_mem:
                if int(m_mem.group(1)) < 5000:
                    free.append(int(m_idx.group(1)))
    return free


def _find_free_nvidia(result: subprocess.CompletedProcess, count: int) -> list[int]:
    """NVIDIA / generic: parse nvidia-smi CSV output."""
    free: list[int] = []
    for line in result.stdout.strip().split("\n"):
        line = line.strip()
        if not line:
            continue
        # Format: "0, 0 MiB, 81559 MiB"
        parts = [p.strip() for p in line.split(",")]
        if len(parts) >= 2:
            try:
                idx = int(parts[0])
                mem = int(parts[1].split()[0])
                if mem < 5000:
                    free.append(idx)
            except (ValueError, IndexError):
                continue
    return free


# ── data ────────────────────────────────────────────────────────────────────


def ensure_data() -> bool:
    """Ensure data/ directory has cases, stats, checkpoints, wheelhouse."""
    data = SCRIPT_DIR / "data"
    if (data / "cases" / "operational_25km").is_dir() and (
        data / "checkpoints" / "google_graphcast_operational_25km_compat_state.pt"
    ).is_file():
        return True

    print(bold("Data not found. Downloading (~1 GB)..."))
    for tool, flag in [("curl", "-L -o"), ("wget", "-O")]:
        if shutil.which(tool):
            run(f"{tool} {flag} {DATA_ARCHIVE} {RELEASE_URL}".split(), cwd=SCRIPT_DIR, timeout=600)
            break
    else:
        print(red("No curl/wget. Please download data manually:"))
        print(red(f"  {RELEASE_URL}"))
        return False

    archive = SCRIPT_DIR / DATA_ARCHIVE
    if archive.exists() and archive.stat().st_size > 0:
        run(["tar", "-xzf", str(archive)], cwd=SCRIPT_DIR)
        archive.unlink()
        print(green("Data ready."))
        return True

    print(red("Download failed."))
    print(red("Please download manually from:"))
    print(red(f"  {RELEASE_URL}"))
    print(red(f"Then extract to: {SCRIPT_DIR / 'data'}"))
    return False


# ── Docker ───────────────────────────────────────────────────────────────────


def container_name(platform: str) -> str:
    return f"{CONTAINER_NAME_PREFIX}_{platform}"


def docker_bin(platform: str) -> list[str]:
    """Return the docker CLI command for this platform."""
    cfg = PLATFORM_CONFIG[platform]
    path = cfg.get("docker_bin", "docker")
    return [path]


def container_running(name: str, platform: str) -> bool:
    d = docker_bin(platform)
    r = run(d + ["ps", "--filter", f"name={name}", "--format", "{{.Names}}"], capture_output=True)
    return name in r.stdout


def container_exists(name: str, platform: str) -> bool:
    d = docker_bin(platform)
    r = run(d + ["container", "inspect", name], capture_output=True)
    return r.returncode == 0


def _container_mount_ok(name: str, d: list[str]) -> bool:
    """Verify the /ws volume mount is healthy inside the container."""
    r = run(
        d + ["exec", "-w", "/", name, "test", "-f", "/ws/ai4s/graphcast/quickstart"],
        capture_output=True,
    )
    return r.returncode == 0


def start_container(platform: str, device_ids: list[int], image: str | None = None) -> bool:
    """Start Docker container if not already running. Returns True if ready."""
    name = container_name(platform)
    d = docker_bin(platform)
    if container_running(name, platform):
        if _container_mount_ok(name, d):
            print(f"Container {name} already running.")
            return True
        # Mount broken — host directory was likely deleted and recreated.
        # Restart the container to re-establish the bind mount.
        print(f"Container {name} mount broken, restarting to fix...")
        run(d + ["stop", name])
        run(d + ["start", name])
        print(f"Container {name} restarted.")
        if _container_mount_ok(name, d):
            return True
        print(red(f"Container {name} mount still broken after restart."))
        return False
    if container_exists(name, platform):
        run(d + ["start", name])
        print(f"Container {name} started.")
        if _container_mount_ok(name, d):
            return True
        print(red(f"Container {name} mount broken."))
        return False

    cfg = PLATFORM_CONFIG[platform]
    img = image or cfg["image"]

    # Build docker run command
    cmd = d + ["run", "-d", "--name", name]

    # Platform-specific flags
    for flag in cfg.get("docker_flags", []):
        cmd.append(flag)

    # Extra devices
    for dev in cfg.get("extra_devices", []):
        cmd.extend(["--device", dev])

    # PPU-specific: pass individual PPU devices
    if platform == "ppu":
        for i in device_ids:
            cmd.extend(["--device", f"/dev/alixpu_ppu{i}"])

    # Volumes: mount project dir
    project_root = str(SCRIPT_DIR.parent.parent)  # ai4s_graphcast/
    cmd.extend(["-v", f"{project_root}:/ws", "-w", "/ws/ai4s/graphcast"])

    # Extra volumes
    for vol in cfg.get("extra_volumes", []):
        cmd.extend(["-v", vol])

    # Env vars
    for key, val in cfg.get("env_vars", {}).items():
        if val == "DEVICE_IDS":
            cmd.extend(["-e", f"{key}={','.join(str(d) for d in device_ids)}"])
        else:
            cmd.extend(["-e", f"{key}={val}"])

    # Mount wheelhouse if found locally
    wheelhouse = SCRIPT_DIR / "data" / "wheelhouse"
    if wheelhouse.is_dir():
        cmd.extend(["-v", f"{wheelhouse}:/wh:ro"])

    cmd.extend([img])
    # Ascend FT3.5 image: entrypoint is /bin/sh, needs -c to pass command
    if platform == "ascend":
        cmd.extend(["-c", "sleep 86400"])
    else:
        cmd.extend(["sleep", "86400"])

    print(bold(f"Starting container {name} ({platform}, GPUs {device_ids})..."))
    r = run(cmd)
    if r.returncode != 0:
        print(red(f"Container start failed: {r.stderr}"))
        return False
    print(green(f"Container {name} running."))
    return True


def stop_container(platform: str) -> None:
    name = container_name(platform)
    d = docker_bin(platform)
    run(d + ["stop", name])
    run(d + ["rm", name])
    print(f"Container {name} removed.")


# ── main ────────────────────────────────────────────────────────────────────


def main() -> None:
    parser = argparse.ArgumentParser(
        description="GraphCast one-click quickstart",
        usage="./quickstart [MODE] [OPTIONS...]",
    )
    parser.add_argument(
        "mode",
        nargs="?",
        default="infer",
        choices=["infer", "train", "all", "container-only"],
        help="Execution mode (default: infer)",
    )
    parser.add_argument("--rm", action="store_true", help="Remove container after execution")
    parser.add_argument("--image", type=str, default=None, help="Docker image to use")
    parser.add_argument(
        "--devices", type=str, default=None, help="Comma-separated GPU/NPU IDs (e.g. 0,1,2,3)"
    )
    parser.add_argument("--steps", type=int, default=3, help="Legacy SGD probe steps (default: 3; not formal training)")
    parser.add_argument(
        "--flagos-mode",
        choices=("off", "flaggems"),
        default="off",
        help="FlagOS mode (default: off)",
    )
    parser.add_argument(
        "--flaggems-ops", type=str, default=None, help="FlagGems ops override (comma-separated)"
    )
    parser.add_argument(
        "--flaggems-config", type=str, default=None, help="FlagGems operator profile override"
    )
    parser.add_argument(
        "--flaggems-src",
        type=str,
        default=None,
        help="Optional FlagGems source root inside the container",
    )
    parser.add_argument(
        "--flaggems-variant",
        choices=("installed", "official", "internal"),
        default="installed",
        help="FlagGems source variant",
    )
    parser.add_argument(
        "--data-source", type=str, default=None, help="Path to graphcast-data directory"
    )

    args, extra = parser.parse_known_args()

    # 1. Detect platform
    platform = detect_platform()
    if not platform:
        print(red("Could not detect platform. Tried: " + ", ".join(GPU_CHECK_CMDS)))
        print(red("Specify platform manually via --platform (not yet implemented)."))
        sys.exit(1)
    print(f"Detected platform: {bold(platform)}")

    # 2. Find free GPUs
    devices = find_free_gpus(platform, user_spec=args.devices)
    min_devices = 4
    if len(devices) < min_devices and args.mode in ("train", "all"):
        print(red(f"Need {min_devices} GPU(s) for training, found {len(devices)} free."))
        print(red("Use --devices to specify GPUs manually."))
        sys.exit(1)
    print(f"Using GPUs: {devices}")

    # 3. Ensure data
    if not ensure_data():
        sys.exit(1)

    # 4. Start container
    if not start_container(platform, devices, image=args.image):
        sys.exit(1)

    if args.mode == "container-only":
        return

    # 5. Run train / infer inside container
    name = container_name(platform)
    device_type = PLATFORM_CONFIG[platform]["device_type"]

    def docker_exec(cmd_str: str) -> int:
        setup = PLATFORM_CONFIG[platform].get("setup_cmd", "")
        if setup:
            cmd_str = f"{setup}; {cmd_str}"
        d = docker_bin(platform)
        full = d + ["exec", name, "bash", "-c", cmd_str]
        return run(full, cwd=SCRIPT_DIR).returncode

    if args.mode in ("infer", "all"):
        print(bold("=== Inference ==="))
        infer_env = build_flagos_environment(
            platform=platform,
            mode=args.flagos_mode,
            ops=args.flaggems_ops,
            profile="inference",
            config=args.flaggems_config,
            source_root=args.flaggems_src,
            variant=args.flaggems_variant,
        )
        infer_cmd = (
            f"{_shell_environment(infer_env)} "
            f"python3 scripts/inference/run_google_small_inference.py"
            f" --device {device_type}"
            f" --config configs/inference/google_graphcast_operational_25km.yaml"
            f" --weights data/checkpoints/google_graphcast_operational_25km_compat_state.pt"
            f" --stats-dir data/stats"
            f" --output /tmp/pred.nc --report /dev/null"
            f" --synthetic-grid tiny"
        )
        if docker_exec(infer_cmd) != 0:
            print(red("Inference failed."))
            sys.exit(1)
        print(green("Inference done."))

    if args.mode in ("train", "all"):
        print(bold("=== Legacy SGD training probe (not formal training) ==="))
        print("For autoregressive AdamW training, use scripts/train.sh with a corpus manifest.")
        train_env = build_flagos_environment(
            platform=platform,
            mode=args.flagos_mode,
            ops=args.flaggems_ops,
            profile="training",
            config=args.flaggems_config,
            source_root=args.flaggems_src,
            variant=args.flaggems_variant,
        )
        device_list = ",".join(f"{device_type}:{i}" for i in range(len(devices)))
        train_cmd = (
            f"{_shell_environment(train_env)} "
            f"python3 -u scripts/training/legacy/lib/train_mp.py"
            f" --steps {args.steps}"
            f" --devices {device_list}"
            f" --mesh2grid-grid-partitions 8"
            f" --lr 1e-6 --optimizer sgd --train-scope all"
        )
        if docker_exec(train_cmd) != 0:
            print(red("Training failed."))
            sys.exit(1)
        print(green("Training done."))

    # 6. Cleanup
    if args.rm:
        stop_container(platform)


if __name__ == "__main__":
    main()
